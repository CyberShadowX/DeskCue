diff --git a/src/DeskCue/Helpers/WidgetPreferredHeightPolicy.cs b/src/DeskCue/Helpers/WidgetPreferredHeightPolicy.cs
new file mode 100644
index 0000000000000000000000000000000000000000..84837843cbeaed56f633761e5ed741368dc41609
--- /dev/null
+++ b/src/DeskCue/Helpers/WidgetPreferredHeightPolicy.cs
@@ -0,0 +1,23 @@
+using Windows.Graphics;
+
+namespace DeskCue.Helpers;
+
+/// <summary>Converts measured DIP content into work-area bounded physical geometry.</summary>
+internal static class WidgetPreferredHeightPolicy
+{
+    internal static RectInt32 Resolve(RectInt32 current, RectInt32 workArea,
+        double contentHeight, double chromeHeight, double scale, int minimumHeight)
+    {
+        if (!double.IsFinite(contentHeight) || !double.IsFinite(chromeHeight) ||
+            !double.IsFinite(scale) || scale <= 0 || contentHeight < 0 || chromeHeight < 0 ||
+            workArea.Height < minimumHeight || workArea.Width < current.Width || workArea.Height <= 0)
+            return current;
+
+        int height = (int)Math.Clamp(Math.Ceiling((contentHeight + chromeHeight) * scale),
+            Math.Max(1, minimumHeight), workArea.Height);
+        return new RectInt32(
+            Math.Clamp(current.X, workArea.X, workArea.X + workArea.Width - current.Width),
+            Math.Clamp(current.Y, workArea.Y, workArea.Y + workArea.Height - height),
+            current.Width, height);
+    }
+}
diff --git a/src/DeskCue/Platform/Win32Helper.TrayMenu.cs b/src/DeskCue/Platform/Win32Helper.TrayMenu.cs
new file mode 100644
index 0000000000000000000000000000000000000000..0450c033d0241de9b560b70910002dcd667a6d15
--- /dev/null
+++ b/src/DeskCue/Platform/Win32Helper.TrayMenu.cs
@@ -0,0 +1,37 @@
+namespace DeskCue.Platform;
+
+public static partial class Win32Helper
+{
+    /// <summary>
+    /// A successful show call is insufficient when a shell extension cloaks
+    /// the menu's real WinUI host. Only query a current, visible, owned host;
+    /// an unavailable DWM attribute is unknown rather than a failure.
+    /// </summary>
+    internal static TrayContextMenuPresentation GetOwnedTrayMenuPresentation(IntPtr hwnd)
+    {
+        if (hwnd == IntPtr.Zero ||
+            GetWindowThreadProcessId(hwnd, out uint processId) == 0 ||
+            processId != (uint)Environment.ProcessId ||
+            !IsWindowVisible(hwnd))
+        {
+            return TrayContextMenuPresentation.Unknown;
+        }
+
+        try
+        {
+            if (DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, out int cloaked, sizeof(int)) != 0)
+            {
+                return TrayContextMenuPresentation.Unknown;
+            }
+
+            return cloaked == 0
+                ? TrayContextMenuPresentation.Visible
+                : TrayContextMenuPresentation.Cloaked;
+        }
+        catch (Exception ex) when (
+            ex is DllNotFoundException or EntryPointNotFoundException or BadImageFormatException)
+        {
+            return TrayContextMenuPresentation.Unknown;
+        }
+    }
+}
