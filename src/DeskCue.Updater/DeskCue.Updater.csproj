<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup><Version>1.5.9.5</Version><AssemblyVersion>1.5.9.5</AssemblyVersion><FileVersion>1.5.9.5</FileVersion><InformationalVersion>1.5.9.5</InformationalVersion>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DeskCue.Updater</RootNamespace>
    <AssemblyName>DeskCue.Updater</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <IsAotCompatible>true</IsAotCompatible>
    <DeskCueAotAudit Condition="'$(DeskCueAotAudit)' == ''">false</DeskCueAotAudit>
    <!-- Switches the shared ShellUnelevatedLaunch source into this
         assembly's own namespace; see that file's header. -->
    <DefineConstants>$(DefineConstants);DESKCUE_UPDATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeskCueAotAudit)' == 'true'">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Shared source with the app project: the shell-integrity restart
       primitive must stay byte-identical on both sides. The file is
       self-contained (BCL + P/Invoke only) because the updater build
       compiles none of the app's other sources. -->
  <ItemGroup>
    <Compile Include="..\DeskCue\Platform\ShellUnelevatedLaunch.cs" Link="Platform\ShellUnelevatedLaunch.cs" />
  </ItemGroup>

</Project>
